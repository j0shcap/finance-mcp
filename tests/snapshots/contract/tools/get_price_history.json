{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": true,
    "title": "Price History (OHLCV)"
  },
  "description": "Historical OHLCV bars plus a summary; long windows are truncated (summary is full).",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "interval": {
        "default": "1d",
        "description": "Bar interval. Intraday intervals (1m-1h) only support short look-backs (1m ~ 7 days, sub-daily ~ 60 days); use 1d+ for long periods.",
        "enum": [
          "1m",
          "5m",
          "15m",
          "30m",
          "1h",
          "1d",
          "1wk",
          "1mo"
        ],
        "type": "string"
      },
      "period": {
        "default": "1mo",
        "description": "Look-back window.",
        "enum": [
          "1d",
          "5d",
          "1mo",
          "3mo",
          "6mo",
          "1y",
          "2y",
          "5y",
          "10y",
          "ytd",
          "max"
        ],
        "type": "string"
      },
      "ticker": {
        "description": "Ticker symbol, e.g. 'AAPL'. Case-insensitive. Yahoo suffixes and prefixes are allowed (BRK-B, ^GSPC, RY.TO, BTC-USD, EURUSD=X); one symbol per value.",
        "maxLength": 24,
        "minLength": 1,
        "pattern": "^\\s*[A-Za-z0-9.\\-^=]{1,20}\\s*$",
        "type": "string"
      }
    },
    "required": [
      "ticker"
    ],
    "type": "object"
  },
  "name": "get_price_history",
  "outputSchema": {
    "description": "OHLCV history plus a computed summary.",
    "properties": {
      "bars": {
        "description": "OHLCV bars (most recent, may be truncated).",
        "items": {
          "description": "One OHLCV bar. Prices are auto-adjusted for splits and dividends.",
          "properties": {
            "close": {
              "description": "Adjusted close, in quote currency.",
              "type": "number"
            },
            "date": {
              "description": "Bar timestamp (ISO 8601). Date-only ('2026-09-25') for the daily and longer intervals (1d/1wk/1mo), which cover whole sessions; a full timestamp with the exchange's UTC offset ('2026-09-25T09:35:00-04:00') for intraday intervals (1m-1h).",
              "type": "string"
            },
            "high": {
              "description": "Adjusted high, in quote currency.",
              "type": "number"
            },
            "low": {
              "description": "Adjusted low, in quote currency.",
              "type": "number"
            },
            "open": {
              "description": "Adjusted open, in quote currency.",
              "type": "number"
            },
            "volume": {
              "description": "Volume, in shares.",
              "type": "number"
            }
          },
          "required": [
            "date",
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "interval": {
        "description": "Requested interval, e.g. '1d'.",
        "type": "string"
      },
      "period": {
        "description": "Requested period, e.g. '1mo'.",
        "type": "string"
      },
      "summary": {
        "description": "Summary computed over the full window.",
        "properties": {
          "bars": {
            "description": "Number of bars in the full window.",
            "type": "integer"
          },
          "end_close": {
            "description": "Adjusted close of the last bar, in quote currency.",
            "type": "number"
          },
          "end_date": {
            "description": "Last bar date/timestamp (see PriceBar.date).",
            "type": "string"
          },
          "period_high": {
            "description": "Highest high over the window, in quote currency.",
            "type": "number"
          },
          "period_low": {
            "description": "Lowest low over the window, in quote currency.",
            "type": "number"
          },
          "start_close": {
            "description": "Adjusted close of the first bar, in quote currency.",
            "type": "number"
          },
          "start_date": {
            "description": "First bar date/timestamp (see PriceBar.date).",
            "type": "string"
          },
          "total_return_percent": {
            "description": "Change from first to last adjusted close, as a PERCENT (5.0 = 5%).",
            "type": "number"
          }
        },
        "required": [
          "start_date",
          "end_date",
          "start_close",
          "end_close",
          "total_return_percent",
          "period_high",
          "period_low",
          "bars"
        ],
        "type": "object"
      },
      "symbol": {
        "description": "Ticker symbol.",
        "type": "string"
      },
      "truncated": {
        "description": "True if bars were capped; summary still covers the full window.",
        "type": "boolean"
      }
    },
    "required": [
      "symbol",
      "period",
      "interval",
      "bars",
      "summary",
      "truncated"
    ],
    "type": "object"
  },
  "title": "Price History (OHLCV)"
}
